# Copy to .env.local (git-ignored) and adjust. Restart `npx expo start` after changes.
#
# EXPO_PUBLIC_* values are embedded in the JavaScript bundle and are readable
# by anyone with the app. NEVER put secrets, API keys or real credentials here.

# Display name used on the splash, login and header.
EXPO_PUBLIC_APP_NAME=Neev Survey

# Data source: "rest" (default: Firebase sign-in + glsstudentapi) or "mock"
# (offline demo login for development only; refused in release builds).
EXPO_PUBLIC_DATA_MODE=rest

# Required in REST mode: the glsstudentapi host only (paths start with /api).
# Local backend: http://<your LAN IP>:8080 (plain http is allowed in development only).
EXPO_PUBLIC_API_BASE_URL=http://192.168.88.50:8080

# Google Sign-In OAuth web client (client_type 3 in google-services.json).
# Defaults to the deeple-80bdf web client. A public identifier, not a secret.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# REST request timeout in milliseconds (1000-120000). Default 15000.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Simulated latency for mock repositories in ms (0-5000). Default 400.
EXPO_PUBLIC_MOCK_LATENCY_MS=400

# Mock mode only (EXPO_PUBLIC_DATA_MODE=mock). Ignored in REST mode.
EXPO_PUBLIC_DEMO_EMAIL=demo@example.com
EXPO_PUBLIC_DEMO_PASSWORD=Demo123!
