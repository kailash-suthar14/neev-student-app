# Copy to .env.local (git-ignored) and adjust. Restart `npx expo start` after changes.
#
# EXPO_PUBLIC_* values are embedded in the JavaScript bundle and are readable
# by anyone with the app. NEVER put secrets, API keys or real credentials here.

# Display name used on the splash, login and header.
EXPO_PUBLIC_APP_NAME=Neev Survey

# Data source: "mock" (offline, AsyncStorage, no network) or "rest" (backend API).
EXPO_PUBLIC_DATA_MODE=mock

# Required when EXPO_PUBLIC_DATA_MODE=rest. http(s) only.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/v1

# REST request timeout in milliseconds (1000-120000). Default 15000.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Simulated latency for mock repositories in ms (0-5000). Default 400.
EXPO_PUBLIC_MOCK_LATENCY_MS=400

# DEVELOPMENT-ONLY mock login. Ignored in REST mode.
EXPO_PUBLIC_DEMO_EMAIL=demo@example.com
EXPO_PUBLIC_DEMO_PASSWORD=Demo123!
